{
  "manifest_version": 3,
  "name": "Social Media Time Tracker",
  "version": "1.5",
  "description": "TLDR: Shows how much time you spend on social media.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [{
    "matches": [
      "*://*.twitter.com/*",
      "*://*.x.com/*",
      "*://*.threads.com/*",
      "*://*.threads.net/*",
      "*://*.instagram.com/*",
      "*://*.facebook.com/*",
      "*://*.messenger.com/*",
      "*://*.linkedin.com/*",
      "*://*.youtube.com/*",
      "*://*.bsky.app/*",
      "*://*.reddit.com/*",
      "*://news.ycombinator.com/*"
    ],
    "js": ["content.js", "feedgate.js"]
  }],
  "background": {
    "service_worker": "background.js"
  }
}
